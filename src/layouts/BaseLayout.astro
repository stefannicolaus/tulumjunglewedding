---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Tulum Jungle Wedding — A Sacred Jungle Venue at Casa Arkaana",
  description = "Tie the knot at Casa Arkaana — a majestic jungle venue near Tulum, Mexico. Conscious weddings for 20–60 guests. Sacred, soulful, unforgettable."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://tulumjunglewedding.com${Astro.url.pathname}`} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
</body>
</html>
